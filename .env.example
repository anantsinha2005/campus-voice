# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=generate-a-secure-random-32-char-key

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_voice?retryWrites=true&w=majority
MONGODB_DB_NAME=campus_voice

# Administrator Configuration (Required for initial provisioning via seed-db or create-admin)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=SetAStrongUniquePasswordHere123!
ADMIN_DEPARTMENT="Administration"
